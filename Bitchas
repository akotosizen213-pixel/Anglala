-- SILENT AIM  (full rewrite — camera locks to target head, releases on death)
--------------------------------------------------------------------
local silentAimTarget     = nil
local silentAimConn
local silentAimDeathConn
local silentAimLocked     = false

local function pickNewSilentTarget(exclude)
    -- Grab the closest valid player that isn't the excluded one
    local best, bestDist = nil, math.huge
    local sc = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == player or p == exclude then continue end
        if Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil then continue end

        local char = p.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        local head = char and char:FindFirstChild("Head")
        if not char or not hum or not head or hum.Health <= 0 then continue end

        local sp, onScreen = camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
        if dist < bestDist then
            bestDist = dist
            best     = p
        end
    end
    return best
end

local function attachSilentAim(target)
    if not target then return end
    silentAimTarget = target
    silentAimLocked = true

    -- Watch for target death → auto-switch
    local char = target.Character
    local hum  = char and char:FindFirstChild("Humanoid")
    if hum then
        if silentAimDeathConn then silentAimDeathConn:Disconnect() end
        silentAimDeathConn = hum.Died:Connect(function()
            silentAimLocked = false
            silentAimTarget = nil
            task.wait(0.1)
            if Settings:Get("SilentAim") then
                local next = pickNewSilentTarget(target)
                if next then attachSilentAim(next) end
            end
        end)
    end
end

local function startSilentAim()
    if silentAimConn then silentAimConn:Disconnect() end

    -- Initial target acquisition
    local initial = pickNewSilentTarget(nil)
    if initial then attachSilentAim(initial) end

    -- Every frame: hard-lock camera to target head
    silentAimConn = RunService.RenderStepped:Connect(function(dt)
        if not Settings:Get("SilentAim") then return end

        -- Re-acquire if no target
        if not silentAimTarget or not silentAimTarget.Character then
            local t = pickNewSilentTarget(nil)
            if t then attachSilentAim(t) end
            return
        end

        local char = silentAimTarget.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        local head = char and char:FindFirstChild("Head")

        if not head or not hum or hum.Health <= 0 then
            silentAimTarget = nil
            return
        end

        local headPos = head.Position + Vector3.new(0, 0.2, 0)  -- slight offset to center of head

        -- Smooth camera lerp toward head
        local currentCF = camera.CFrame
        local targetCF  = CFrame.new(currentCF.Position, headPos)

        -- Lerp factor: higher = snappier
        local lerpFactor = math.clamp(dt * 22, 0, 1)
        camera.CFrame = currentCF:Lerp(targetCF, lerpFactor)
    end)
end

local function stopSilentAim()
    silentAimLocked = false
    silentAimTarget = nil
    if silentAimConn      then silentAimConn:Disconnect();      silentAimConn      = nil end
    if silentAimDeathConn then silentAimDeathConn:Disconnect(); silentAimDeathConn = nil end
end

Settings:Connect("SilentAim", function(on)
    if on then startSilentAim() else stopSilentAim() end
end)

-- Also re-acquire when new players join
Players.PlayerAdded:Connect(function(p)
    if not Settings:Get("SilentAim") then return end
    task.wait(3)  -- wait for character to load
    if not silentAimTarget then
        local t = pickNewSilentTarget(nil)
        if t then attachSilentAim(t) end
    end
end)

