-- No Recoil core: pitch correction + fire rate throttle via RenderStepped
Settings:Connect("NoRecoil", function(on)
    noRecoilActive = on
    if noRecoilConn2 then noRecoilConn2:Disconnect(); noRecoilConn2 = nil end

    if on then
        local BASE_PITCH = nil  -- locked pitch reference

        noRecoilConn2 = RunService.RenderStepped:Connect(function(dt)
            if not Settings:Get("NoRecoil") then return end

            local cur              = camera.CFrame
            local pitch, yaw, roll = cur:ToOrientation()

            -- Lock base pitch on first frame
            if BASE_PITCH == nil then BASE_PITCH = pitch end

            -- Hard clamp camera pitch drift back to base
            local pitchDrift = pitch - BASE_PITCH
            if math.abs(pitchDrift) > 0.003 then
                local corrected = BASE_PITCH + pitchDrift * 0.04  -- near-zero recoil
                camera.CFrame   = CFrame.new(cur.Position)
                    * CFrame.fromOrientation(corrected, yaw, roll)
            end

            -- Fire rate gate: auto-fire input throttled to RPM
            local now       = tick()
            local interval  = 60 / fireRate
            if now - lastShotTime >= interval then
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    lastShotTime = now
                    -- Signal: dispatch a re-fire event to reset recoil accumulation
                    -- (game-specific — hook your RemoteEvent here if needed)
                end
            end
        end)

        -- Update BASE_PITCH when user intentionally aims (RMB held = intentional aim)
        RunService.RenderStepped:Connect(function()
            if not Settings:Get("NoRecoil") then return end
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local c = camera.CFrame
                local p, _, _ = c:ToOrientation()
                BASE_PITCH = p  -- re-anchor on intentional aim
            end
        end)
    end
end)
