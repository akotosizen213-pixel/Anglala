-- NOCLIP  (full rewrite — per-step force disable, handles respawn)
--------------------------------------------------------------------
local noclipConn2
local NOCLIP_IGNORE = { "HumanoidRootPart", "Head" }  -- always noclip these

local function setNoclipState(on)
    if noclipConn2 then noclipConn2:Disconnect(); noclipConn2 = nil end

    if on then
        -- Aggressive: kill collision every single physics step
        noclipConn2 = RunService.Stepped:Connect(function()
            local char = player.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    -- Also zero out any contact forces trying to push back
                    if part:IsA("MeshPart") or part:IsA("Part") then
                        part.CanTouch = false
                    end
                end
            end
        end)

        -- Also disable for newly added character parts mid-game
        local conn
        conn = player.CharacterAdded:Connect(function(char)
            if not Settings:Get("Noclip") then conn:Disconnect(); return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch   = false
                end
            end
            char.DescendantAdded:Connect(function(d)
                if d:IsA("BasePart") and Settings:Get("Noclip") then
                    d.CanCollide = false
                    d.CanTouch   = false
                end
            end)
        end)
    else
        -- Restore on disable
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                    part.CanTouch   = true
                end
            end
        end
    end
end

Settings:Connect("Noclip", setNoclipState)

